# Copy to /etc/sig-engine/env (mode 0600, owner sig) on the server, or export in your shell. Never commit the real file.
SIG_API_KEY=            # SIG Super Market API key (My Profile -> API Keys, read + trade)
SIG_ENGINE_HOST=        # the one machine allowed to run --live (its LocalHostName, or the id in data/host_id)
SIG_DATA=/opt/sig-engine/data   # where the engine writes its state; tests use a temp dir by themselves
SIG_SERVER=             # user@host, for deploy/server/*.sh and the research scripts that read the server over ssh
MAC_STATE_JSON=         # optional: a copy of another machine's state.json, for the two-engines guard in start.sh
NTFY_TOPIC=             # optional: ntfy topic for the ops alerts (deploy/server/ops/ops.py)
SETTLE_TO=              # optional: the organisers' address for the settlement-watch email draft
